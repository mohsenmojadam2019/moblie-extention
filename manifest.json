{
  "manifest_version": 3,
  "name": "Responsive Mobile Studio",
  "short_name": "Mobile Studio",
  "version": "1.0.0",
  "description": "Preview websites on multiple phone sizes and inspect real Chrome tabs with mobile device emulation.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "debugger",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Responsive Mobile Studio",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
